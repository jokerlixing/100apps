{
  "manifest_version": 3,
  "name": "MARGIN / 84 · 划词翻译",
  "version": "1.0.0",
  "description": "选中文字，在阅读现场查看带来源说明的翻译批注。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MARGIN 划词翻译",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["content.css"],
      "js": ["translator-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
